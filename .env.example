# ISHA environment configuration — copy to `.env` and fill in.
# Every key is optional: without them ISHA runs its deterministic offline brain.

# ── Planning (long-context reasoning) ──────────────────────────────────────
GOOGLE_API_KEY=
PLANNER_MODEL=gemini/gemini-2.5-flash

# ── Patching + fallback (fast code generation) ─────────────────────────────
GROQ_API_KEY=
CODER_MODEL=llama-3.3-70b-versatile
# Comma-separated fallback chain tried when the primary coder fails
CODER_FALLBACKS=llama-3.1-8b-instant,llama3-70b-8192

# ── Observability ──────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Set to 1 to forward litellm calls to Langfuse (off by default)
ISHA_LITELLM_LANGFUSE=0

# ── Retrieval ──────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=isha_codebase

# ── Runtime switches ───────────────────────────────────────────────────────
# Force the offline deterministic brain even when keys are present
ISHA_FORCE_OFFLINE=0
# Audit log for approval decisions
ISHA_APPROVALS_FILE=approvals.jsonl
