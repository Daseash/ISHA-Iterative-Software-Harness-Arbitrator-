# ISHA environment configuration — copy to `.env` and fill in.
# Every key is optional: without them ISHA runs its deterministic offline brain.

# ── Planning (long-context reasoning) ──────────────────────────────────────
GOOGLE_API_KEY=
ISHA_PLANNER_MODEL=groq/openai/gpt-oss-120b
ISHA_PLANNER_FALLBACKS=groq/openai/gpt-oss-20b,gemini/gemini-3.8-flash,gemini/gemini-3.5-flash,gemini/gemini-3.1-flash-lite

# ── Patching (fast code generation) ────────────────────────────────────────
GROQ_API_KEY=
ISHA_CODER_MODEL=groq/openai/gpt-oss-20b
ISHA_CODER_FALLBACKS=groq/openai/gpt-oss-120b,gemini/gemini-3.8-flash,gemini/gemini-3.5-flash,gemini/gemini-3.1-flash-lite

# ── Observability ──────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Set to 1 to forward litellm calls to Langfuse (off by default)
ISHA_LITELLM_LANGFUSE=0

# ── Retrieval ──────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=isha_codebase

# ── Runtime switches ───────────────────────────────────────────────────────
# Force the offline deterministic brain even when keys are present
ISHA_FORCE_OFFLINE=0
# Audit log for approval decisions
ISHA_APPROVALS_FILE=output/approvals.jsonl

# ── Sandbox ────────────────────────────────────────────────────────────────
# local: run pytest on the host (default) · docker: run pytest in a container
ISHA_SANDBOX_MODE=local
ISHA_SANDBOX_IMAGE=isha-sandbox:latest
ISHA_SANDBOX_NETWORK=none
ISHA_SANDBOX_MEMORY=1g
ISHA_SANDBOX_CPUS=2
ISHA_SANDBOX_USER=

# Target repository (any real checkout works)
TARGET_REPO_PATH=tests/dummy_repo

# Senior-dev instincts
# Planner confidence below this escalates to human review (0-1, disable with 1)
ISHA_CONFIDENCE_THRESHOLD=0.4
# Blast-radius auto-escalation thresholds
ISHA_BLAST_REVIEW_SCORE=0.4
ISHA_BLAST_REVIEW_CALLERS=150
