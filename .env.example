# ISHA environment configuration — copy to `.env` and fill in.
# Every key is optional: without them ISHA runs its deterministic offline brain.

# ── Planning (long-context reasoning) ──────────────────────────────────────
GOOGLE_API_KEY=
ISHA_PLANNER_MODEL=gemini/gemini-3.1-flash-lite
ISHA_PLANNER_FALLBACKS=groq/qwen/qwen3.8-27b

# ── Patching + fallback (fast code generation) ─────────────────────────────
GROQ_API_KEY=
ISHA_CODER_MODEL=groq/qwen/qwen3.8-27b
# Comma-separated fallback chain tried when the primary coder fails
ISHA_CODER_FALLBACKS=groq/allam-2-7b,gemini/gemini-3.1-flash-lite

# ── Observability ──────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Set to 1 to forward litellm calls to Langfuse (off by default)
ISHA_LITELLM_LANGFUSE=0

# ── Retrieval ──────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=isha_codebase

# ── Runtime switches ───────────────────────────────────────────────────────
# Force the offline deterministic brain even when keys are present
ISHA_FORCE_OFFLINE=0
# Audit log for approval decisions
ISHA_APPROVALS_FILE=output/approvals.jsonl

# ── Sandbox ────────────────────────────────────────────────────────────────
# local: run pytest on the host (default) · docker: run pytest in a container
ISHA_SANDBOX_MODE=local
ISHA_SANDBOX_IMAGE=isha-sandbox:latest
# Container network policy for test runs (none = fully offline)
ISHA_SANDBOX_NETWORK=none
ISHA_SANDBOX_MEMORY=1g
ISHA_SANDBOX_CPUS=2
# Run the container as uid:gid (Linux hosts; leave blank on Windows)
ISHA_SANDBOX_USER=
