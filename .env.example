# ISHA environment configuration — copy to `.env` and fill in.
# Every key is optional: without them ISHA runs its deterministic offline brain.
#
# The model chain below is the one the published SWE-bench Lite numbers were
# produced with. Keep it unchanged when reproducing them: swapping the coder
# model changes the patches and therefore the resolve count. Which model
# actually answered each call is recorded per-call in every
# results/<run_id>/<instance>/meta.json under model_log[].model / .position,
# so any run is auditable after the fact.

# ── API Keys (Free Tier Providers — $0.00 Cost, Zero VRAM Required) ───────
# Single keys (backward-compatible) or comma-separated pools (round-robin rotation):
# Google AI Studio (Gemini 3.5/3.8 Flash):
GOOGLE_API_KEY=
# GEMINI_API_KEYS=key1,key2,key3
# Groq Cloud (Ultra-Fast LPUs — Qwen 2.5 Coder 32B, GPT-OSS-120B, DeepSeek-R1 Distill 70B):
GROQ_API_KEY=
# GROQ_API_KEYS=key1,key2
# Mistral AI Platform (Codestral — Repo-level SEARCH/REPLACE diffs):
MISTRAL_API_KEY=
# MISTRAL_API_KEYS=key1,key2
# Cerebras Cloud (Ultra-fast 2000 tok/s inference):
CEREBRAS_API_KEY=
# CEREBRAS_API_KEYS=key1,key2
# OpenRouter (:free tier models):
OPENROUTER_API_KEY=
# OPENROUTER_API_KEYS=key1,key2

# ── 100% Cloud-Hosted Model Routing Architecture ──────────────────────────
# Node 3: Planner / Root Cause Analysis (Deep reasoning)
ISHA_PLANNER_MODEL=groq/openai/gpt-oss-120b
ISHA_PLANNER_FALLBACKS=gemini/gemini-3.8-flash,gemini/gemini-3.5-flash-lite,gemini/gemini-3.5-flash

# Node 5: Regression Test Generation (Phase RED failing reproduction tests)
ISHA_REPRO_MODEL=groq/deepseek-r1-distill-llama-70b
ISHA_REPRO_FALLBACKS=groq/openai/gpt-oss-120b,gemini/gemini-3.8-flash,gemini/gemini-3.5-flash

# Default Fast Coder / High-Throughput Tier
ISHA_CODER_MODEL=gemini/gemini-3.5-flash-lite
ISHA_CODER_FALLBACKS=gemini/gemini-3.8-flash,gemini/gemini-3.5-flash

# Node 6: Multi-Model Tournament Strategy Mapping
ISHA_CANDIDATES=3
ISHA_MODEL_MINIMAL_DIFF=mistral/codestral-latest
ISHA_MODEL_CALL_SITE_AWARE=gemini/gemini-3.8-flash
ISHA_MODEL_ROOT_CAUSE_FIRST=groq/openai/gpt-oss-120b
ISHA_MODEL_DEFENSIVE_FIX=mistral/codestral-latest
ISHA_MODEL_CROSS_FILE_AUDIT=gemini/gemini-3.8-flash

# ── Observability ──────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Set to 1 to forward litellm calls to Langfuse (off by default)
ISHA_LITELLM_LANGFUSE=0

# ── Retrieval ──────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=isha_codebase

# ── Runtime switches ───────────────────────────────────────────────────────
# Force the offline deterministic brain even when keys are present
ISHA_FORCE_OFFLINE=0
# Audit log for approval decisions
ISHA_APPROVALS_FILE=output/approvals.jsonl

# ── Rate limiting (free-tier quota) ────────────────────────────────────────
# 1: on a 429, wait out the provider's TPM window and retry the SAME model
#    instead of advancing to the (usually weaker) next model in the chain.
#    Keep this on for single-account free-tier runs: degrading to a fallback
#    model mid-instance is what turns a transient quota blip into a bad patch.
# 0: advance the chain immediately on any 429 (useful only with several
#    independent provider accounts to spread load across).
ISHA_RATE_LIMIT_WAIT=1

# ── Benchmark throughput ───────────────────────────────────────────────────
# Solve N instances in parallel (`isha bench --workers` overrides this).
# 1 is the safe default on a shared free-tier TPM window.
ISHA_BENCH_WORKERS=1
# Per-instance wall budget in seconds.
ISHA_BENCH_INSTANCE_TIMEOUT=1800
# Context budgets (raise only when the provider quota tolerates bigger prompts).
ISHA_MAX_CONTEXT_CHARS=40000
ISHA_MAX_FILE_LINES=400

# ── Sandbox ────────────────────────────────────────────────────────────────
# local: run pytest on the host (default) · docker: run pytest in a container
ISHA_SANDBOX_MODE=local
ISHA_SANDBOX_IMAGE=isha-sandbox:latest
ISHA_SANDBOX_NETWORK=none
ISHA_SANDBOX_MEMORY=1g
ISHA_SANDBOX_CPUS=2
ISHA_SANDBOX_USER=

# Target repository (any real checkout works)
TARGET_REPO_PATH=tests/dummy_repo

# Senior-dev instincts
# Planner confidence below this escalates to human review (0-1, disable with 1)
ISHA_CONFIDENCE_THRESHOLD=0.4
# Blast-radius auto-escalation thresholds
ISHA_BLAST_REVIEW_SCORE=0.4
ISHA_BLAST_REVIEW_CALLERS=150
